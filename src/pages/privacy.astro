---
// Privacy policy. Address: /privacy/
// Keep it honest and update it whenever you add a new tool that collects data.
import BaseLayout from '../layouts/BaseLayout.astro';
import { CONTACT_EMAIL, SITE_NAME } from '../lib/site';

// Google Analytics is only mentioned when it's actually switched on
// (when the PUBLIC_GA_ID setting has a value, the same check BaseLayout uses).
const usesAnalytics = Boolean(import.meta.env.PUBLIC_GA_ID);
---

<BaseLayout
  title={`Privacy Policy | ${SITE_NAME}`}
  description={usesAnalytics
    ? `How ${SITE_NAME} uses analytics and affiliate links, and what information is and isn't collected.`
    : `How ${SITE_NAME} handles your information: no accounts, no tracking, and how affiliate links work.`}
>
  <article class="guide">
    <h1>Privacy policy</h1>
    <p class="lead">Last updated: October 12, 2026</p>

    <h2>What we collect</h2>
    <ul>
      <li>
        <strong>No accounts, no names, no emails.</strong> You can use the whole site without signing up.
      </li>
      {
        usesAnalytics ? (
          <li>
            <strong>Anonymous usage statistics</strong> through Google Analytics: which pages are visited, the
            approximate country and city a visit comes from, device type, and finder actions (for example
            "chose Laptops" or "requested a new country"). We use this to decide which products and countries
            to add next.
          </li>
        ) : (
          <li>
            <strong>No analytics or tracking.</strong> We don't use any tool that tracks your visits.
          </li>
        )
      }
      <li>
        <strong>Your chosen country</strong> is remembered in your own browser (local storage) so you don't
        have to pick it again. It never leaves your device.
      </li>
    </ul>

    <h2>Cookies</h2>
    {
      usesAnalytics ? (
        <p>
          Google Analytics uses cookies to count visits. You can block or delete cookies in your browser
          settings, or install Google's{' '}
          <a href="https://tools.google.com/dlpage/gaoptout" rel="noopener">Analytics opt-out add-on</a>.
        </p>
      ) : (
        <p>This site doesn't set any cookies of its own.</p>
      )
    }

    <h2>Affiliate links</h2>
    <p>
      When you click a store link (Shopee, Lazada), you leave our site. The store and its
      affiliate network may use cookies to know the visit came from us, so we can earn a small commission at
      no extra cost to you. Their own privacy policies apply on their sites.
    </p>

    <h2>Contact</h2>
    <p>Questions about privacy? Email us at <a href={`mailto:${CONTACT_EMAIL}`}>{CONTACT_EMAIL}</a>.</p>
  </article>
</BaseLayout>
